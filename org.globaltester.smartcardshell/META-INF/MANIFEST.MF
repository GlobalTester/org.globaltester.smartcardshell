 org.globaltester.logging,
 org.globaltester.lib.smartcardio,
 org.globaltester.cryptoprovider.bc,
 org.globaltester.control,
 org.globaltester.control.soap,
 slf4j.api
Bundle-RequiredExecutionEnvironment: JavaSE-17
Bundle-ActivationPolicy: lazy
Eclipse-BundleShape: dir
DynamicImport-Package: *
Bundle-ClassPath: .,
 scsh-3.18.12/lib/ocf-core.jar,
 scsh-3.18.12/lib/ocf-daemon.jar,
 scsh-3.18.12/lib/ocf-ui.jar,
 scsh-3.18.12/lib/scdp4j.jar,
 scsh-3.18.12/lib/scsh-3.18.12.jar,
 scsh-3.18.12/lib/opensc-java.jar,
 scsh-3.18.12/lib/sc-hsm-jceprovider.jar
Export-Package: de.cardcontact.opencard.factory,
 de.cardcontact.opencard.security,
 de.cardcontact.opencard.service,
 de.cardcontact.opencard.service.eac20,
 de.cardcontact.opencard.service.globalplatform,
 de.cardcontact.opencard.service.isocard,
 de.cardcontact.opencard.service.isocard.apdu,
 de.cardcontact.opencard.service.remoteclient,
 de.cardcontact.opencard.service.smartcardhsm,
 de.cardcontact.opencard.terminal.ctapi4ocf,
 de.cardcontact.opencard.terminal.jcopsim,
 de.cardcontact.opencard.utils,
 de.cardcontact.scdp.cardsim,
 de.cardcontact.scdp.cms,
 de.cardcontact.scdp.cryptoscript,
 de.cardcontact.scdp.engine,
 de.cardcontact.scdp.gp,
 de.cardcontact.scdp.js,
 de.cardcontact.scdp.ocsp,
 de.cardcontact.scdp.pkcs11,
 de.cardcontact.scdp.utils,
 de.cardcontact.scdp.xmldsig,
 de.cardcontact.scdp.scsh3,
 de.cardcontact.ctapi,
 de.cardcontact.tlv,
 opencard.core,
 opencard.core.event,
 opencard.core.service,
 opencard.core.terminal,
 opencard.core.util,
 opencard.opt.applet,
 opencard.opt.iso.fs,
 opencard.opt.security,
 opencard.opt.service,
 opencard.opt.signature,
 opencard.opt.terminal,
 opencard.opt.util,
 org.globaltester.smartcardshell,
 org.globaltester.smartcardshell.cms,
 org.globaltester.smartcardshell.gp,
 org.globaltester.smartcardshell.jsinterface,
 org.globaltester.smartcardshell.ocf,
 org.globaltester.smartcardshell.preferences,
 org.globaltester.smartcardshell.protocols
Eclipse-ExtensibleAPI: true
Import-Package: javax.jws,
 org.eclipse.jface.preference
