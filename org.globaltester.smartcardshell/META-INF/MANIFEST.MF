Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Automatic-Module-Name: org.globaltester.smartcardshell
Bundle-Name: GT SmartCardShell
Bundle-SymbolicName: org.globaltester.smartcardshell;singleton:=true
Bundle-Version: 3.9.0.qualifier
Bundle-Activator: org.globaltester.smartcardshell.Activator
Bundle-Vendor: secunet Security Networks AG
Require-Bundle: org.eclipse.core.runtime,
 org.globaltester.logging.legacy,
 org.eclipse.ui.workbench,
 org.mozilla.javascript,
 org.eclipse.wst.jsdt.debug.rhino.debugger,
 org.eclipse.core.resources,
